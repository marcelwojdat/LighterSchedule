# Copy to .env and fill in. Real environment variables (e.g. docker-compose) take precedence.

# --- Django ---
# Local development: True (no HTTPS redirect, console e-mail, readable errors).
# Production: False — then DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Production behind HTTPS, e.g.:
# CSRF_TRUSTED_ORIGINS=https://twoja-domena.pl
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Database (PostgreSQL) ---
DB_NAME=lighterschedule_db
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# --- Frontend access ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- E-mail (DEBUG prints e-mails to the runserver console) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ProstyGrafik <noreply@prostygrafik.pl>
